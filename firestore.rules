rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function accessExists() { return exists(/databases/$(database)/documents/_recovery/access); }
    function identityReadable() {
      return (!accessExists() && database == '(default)') || (accessExists()
        && get(/databases/$(database)/documents/_recovery/access).data.databaseId == database
        && get(/databases/$(database)/documents/_recovery/access).data.phase != 'retired');
    }
    function recoveryAdministrator() {
      return signedInAndEnabled() && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.role in ['developer_superuser', 'house_solution_administrator'];
    }
    function businessReadable() {
      return identityReadable() && (!accessExists()
        || get(/databases/$(database)/documents/_recovery/access).data.phase == 'normal'
        || (get(/databases/$(database)/documents/_recovery/access).data.phase == 'verification' && recoveryAdministrator()));
    }
    function businessWritable() {
      return identityReadable() && (!accessExists() || get(/databases/$(database)/documents/_recovery/access).data.phase == 'normal');
    }
    function signedInAndEnabled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.enabled == true;
    }

    function signedInCompanyEnabled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/constructionCompanyAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/constructionCompanyAccounts/$(request.auth.uid)).data.enabled == true;
    }

    function currentCompanyId() {
      return get(/databases/$(database)/documents/constructionCompanyAccounts/$(request.auth.uid)).data.constructionCompanyId;
    }

    match /staffAccounts/{uid} {
      allow read: if identityReadable() && request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function prototypeCompanyOwns(data) {
      let account = get(/databases/$(database)/documents/constructionCompanyAccounts/$(request.auth.uid)).data;
      return signedInCompanyEnabled() && data.constructionCompanyId == account.constructionCompanyId
        && (account.scope == 'company' || (account.scope == 'branch' && data.branchId == account.branchId));
    }
    match /propertyWarranties/{propertyId} {
      allow read: if businessReadable() && (signedInAndEnabled() || (request.auth != null && prototypeCompanyOwns(resource.data)));
      allow write: if businessWritable() && signedInAndEnabled();
    }
    match /companyBranches/{branchId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }
    match /warrantyGroups/{groupId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }
    match /warrantyCounters/{groupId} {
      allow read, write: if false;
    }

    match /constructionCompanyAccounts/{uid} {
      allow read: if identityReadable() && request.auth != null && (request.auth.uid == uid || (businessReadable() && signedInAndEnabled()));
      allow write: if false;
    }

    match /accountMutationLocks/{uid} {
      allow read, write: if false;
    }

    match /constructionCompanyAccountBindings/{companyId} {
      allow read, write: if false;
    }

    match /constructionCompanyCaseWorkItems/{workItemId} {
      allow read: if businessReadable() && (signedInAndEnabled()
        || (signedInCompanyEnabled() && resource.data.constructionCompanyId == currentCompanyId()));
      allow write: if false;
    }

    match /notificationOutbox/{notificationId} {
      allow read, write: if false;
    }

    // Staff business-data Rules intentionally enforce only authentication and
    // the live enabled-account boundary. Canonical shapes, business invariants,
    // lifecycle transitions, and soft-delete behavior belong to the application.
    match /branches/{branchId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }

    match /constructionCompanies/{companyId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }

    match /homeowners/{homeownerId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }

    match /properties/{propertyId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }

    match /warrantyServices/{serviceId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
    }

    // Firestore collection-group queries require a recursive wildcard match.
    match /{path=**}/appliedWarranties/{warrantyId} {
      allow read: if businessReadable() && (signedInAndEnabled());
    }

    match /cases/{caseId} {
      allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();

      match /appliedWarranties/{warrantyId} {
        allow read: if businessReadable() && signedInAndEnabled();
      allow write: if businessWritable() && signedInAndEnabled();
      }
    }

    // These documents are server-owned implementation state, not staff business
    // records. Browser reads support the current UI; writes remain Admin-only.
    match /systemCounters/{counterId} {
      allow read: if businessReadable() && (signedInAndEnabled() && counterId == 'caseNumber');
      allow write: if false;
    }

    match /caseNumberReservations/{caseNumber} {
      allow read: if businessReadable() && (signedInAndEnabled());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
