rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAndEnabled() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.enabled == true;
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function nonBlankString(value) {
      return nonEmptyString(value) && value.matches('.*\\S.*');
    }

    function validStatus(data) {
      return data.status in ['active', 'cancelled', 'invalid']
        && ((data.status == 'active' && data.statusReason == null)
          || (data.status != 'active' && nonBlankString(data.statusReason)));
    }

    function canonicalDate(value) {
      return value is string && value.matches('^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$');
    }

    function validCaseDates(data) {
      return data.keys().hasAll(['applicationDate', 'handoverDate'])
        && canonicalDate(data.applicationDate)
        && canonicalDate(data.handoverDate);
    }

    function legacyWarrantyParentUpdateOnly() {
      return !resource.data.keys().hasAny(['applicationDate', 'handoverDate'])
        && !request.resource.data.keys().hasAny(['applicationDate', 'handoverDate'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
    }

    function activeHomeowner(homeownerId) {
      return get(/databases/$(database)/documents/homeowners/$(homeownerId)).data.active == true;
    }

    function activeConstructionCompany(companyId) {
      return get(/databases/$(database)/documents/constructionCompanies/$(companyId)).data.active == true;
    }

    function activeUsableProperty(propertyId) {
      return get(/databases/$(database)/documents/properties/$(propertyId)).data.active == true
        && activeHomeowner(get(/databases/$(database)/documents/properties/$(propertyId)).data.homeownerId)
        && activeConstructionCompany(get(/databases/$(database)/documents/properties/$(propertyId)).data.constructionCompanyId);
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    function validAddress(value) {
      return value is map
        && value.keys().hasOnly(['postalCode', 'prefecture', 'municipality', 'streetTownAndNumber', 'buildingName'])
        && value.postalCode is string && value.postalCode.matches('^[0-9]{7}$')
        && nonBlankString(value.prefecture)
        && nonBlankString(value.municipality)
        && nonBlankString(value.streetTownAndNumber)
        && nullableString(value.buildingName);
    }

    function validNameSearch(value) {
      return value is map
        && value.keys().hasOnly(['normalized', 'one', 'two'])
        && nonEmptyString(value.normalized)
        && value.one is map
        && value.two is map;
    }

    function validMasterCreateMetadata(data) {
      return data.active is bool
        && data.revision is int
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validMasterUpdateMetadata(data) {
      return data.active is bool
        && resource.data.revision is int
        && resource.data.revision >= 1
        && resource.data.revision < 9007199254740991
        && data.revision == resource.data.revision + 1
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }

    function masterLifecycleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['active', 'revision', 'updatedAt']);
    }

    function validMasterLifecycleUpdate(data) {
      return masterLifecycleFieldsOnly() && validMasterUpdateMetadata(data);
    }

    function validActivePropertyReferences(data) {
      return !data.active
        || (data.homeownerId is string
          && data.constructionCompanyId is string
          && exists(/databases/$(database)/documents/homeowners/$(data.homeownerId))
          && exists(/databases/$(database)/documents/constructionCompanies/$(data.constructionCompanyId))
          && activeHomeowner(data.homeownerId)
          && activeConstructionCompany(data.constructionCompanyId));
    }

    function validCompany(data) {
      return data.keys().hasOnly(['name', 'address', 'telephone', 'fax', 'contactPerson', 'contactDetails', 'email', 'notes', 'active', 'nameSearch', 'revision', 'createdAt', 'updatedAt'])
        && nonBlankString(data.name)
        && validAddress(data.address)
        && nullableString(data.telephone)
        && nullableString(data.fax)
        && nullableString(data.contactPerson)
        && nullableString(data.contactDetails)
        && nullableString(data.email)
        && nullableString(data.notes)
        && validNameSearch(data.nameSearch);
    }

    function validHomeowner(data) {
      return data.keys().hasOnly(['name', 'address', 'telephone', 'fax', 'notes', 'active', 'nameSearch', 'revision', 'createdAt', 'updatedAt'])
        && nonBlankString(data.name)
        && validAddress(data.address)
        && nullableString(data.telephone)
        && nullableString(data.fax)
        && nullableString(data.notes)
        && validNameSearch(data.nameSearch);
    }

    function validProperty(data) {
      return data.keys().hasOnly(['name', 'homeownerId', 'constructionCompanyId', 'address', 'active', 'nameSearch', 'revision', 'createdAt', 'updatedAt'])
        && nonBlankString(data.name)
        && nonEmptyString(data.homeownerId)
        && nonEmptyString(data.constructionCompanyId)
        && validAddress(data.address)
        && validNameSearch(data.nameSearch)
        && exists(/databases/$(database)/documents/homeowners/$(data.homeownerId))
        && exists(/databases/$(database)/documents/constructionCompanies/$(data.constructionCompanyId))
        && validActivePropertyReferences(data);
    }

    function validWarrantyService(data) {
      return data.keys().hasOnly(['name', 'defaultPeriodYears', 'active', 'revision', 'createdAt', 'updatedAt'])
        && nonBlankString(data.name)
        && data.defaultPeriodYears is int
        && data.defaultPeriodYears > 0;
    }

    match /staffAccounts/{uid} {
      allow read: if signedInAndEnabled() && request.auth.uid == uid;
      allow write: if false;
    }

    match /branches/{branchId} {
      allow read: if signedInAndEnabled();
      allow create, update: if signedInAndEnabled()
        && request.resource.data.keys().hasOnly(['name', 'active'])
        && nonEmptyString(request.resource.data.name)
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /constructionCompanies/{companyId} {
      allow read: if signedInAndEnabled();
      allow create: if signedInAndEnabled() && validCompany(request.resource.data) && validMasterCreateMetadata(request.resource.data);
      allow update: if signedInAndEnabled()
        && ((validCompany(request.resource.data) && validMasterUpdateMetadata(request.resource.data))
          || validMasterLifecycleUpdate(request.resource.data));
      allow delete: if false;
    }

    match /homeowners/{homeownerId} {
      allow read: if signedInAndEnabled();
      allow create: if signedInAndEnabled() && validHomeowner(request.resource.data) && validMasterCreateMetadata(request.resource.data);
      allow update: if signedInAndEnabled()
        && ((validHomeowner(request.resource.data) && validMasterUpdateMetadata(request.resource.data))
          || validMasterLifecycleUpdate(request.resource.data));
      allow delete: if false;
    }

    match /properties/{propertyId} {
      allow read: if signedInAndEnabled();
      allow create: if signedInAndEnabled() && validProperty(request.resource.data) && validMasterCreateMetadata(request.resource.data);
      allow update: if signedInAndEnabled()
        && ((validProperty(request.resource.data) && validMasterUpdateMetadata(request.resource.data))
          || (validMasterLifecycleUpdate(request.resource.data)
            && validActivePropertyReferences(request.resource.data)));
      allow delete: if false;
    }

    match /warrantyServices/{serviceId} {
      allow read: if signedInAndEnabled();
      allow create: if signedInAndEnabled() && validWarrantyService(request.resource.data) && validMasterCreateMetadata(request.resource.data);
      allow update: if signedInAndEnabled()
        && ((validWarrantyService(request.resource.data) && validMasterUpdateMetadata(request.resource.data))
          || validMasterLifecycleUpdate(request.resource.data));
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if signedInAndEnabled();
      allow create: if false;
      allow update: if signedInAndEnabled()
        && resource.data.status == 'active'
        && request.resource.data.keys().hasOnly([
          'caseNumber', 'sequenceValue', 'propertyId', 'homeownerId',
          'constructionCompanyId', 'responsibleBranchId', 'status',
          'statusReason', 'registrationWarrantyId', 'applicationDate', 'handoverDate',
          'registeredAt', 'updatedAt'
        ])
        && request.resource.data.caseNumber == resource.data.caseNumber
        && request.resource.data.sequenceValue == resource.data.sequenceValue
        && request.resource.data.registrationWarrantyId == resource.data.registrationWarrantyId
        && request.resource.data.registeredAt == resource.data.registeredAt
        && request.resource.data.updatedAt == request.time
        && (validCaseDates(request.resource.data) || legacyWarrantyParentUpdateOnly())
        && validStatus(request.resource.data)
        && ((request.resource.data.propertyId == resource.data.propertyId
            && (request.resource.data.homeownerId == resource.data.homeownerId
              || activeHomeowner(request.resource.data.homeownerId))
            && (request.resource.data.constructionCompanyId == resource.data.constructionCompanyId
              || activeConstructionCompany(request.resource.data.constructionCompanyId)))
          || (request.resource.data.propertyId != resource.data.propertyId
            && activeUsableProperty(request.resource.data.propertyId)
            && activeHomeowner(request.resource.data.homeownerId)
            && activeConstructionCompany(request.resource.data.constructionCompanyId)))
        && (request.resource.data.responsibleBranchId == resource.data.responsibleBranchId
          || (exists(/databases/$(database)/documents/branches/$(request.resource.data.responsibleBranchId))
            && get(/databases/$(database)/documents/branches/$(request.resource.data.responsibleBranchId)).data.active == true));
      allow delete: if false;

      match /appliedWarranties/{warrantyId} {
        allow read: if signedInAndEnabled();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    match /systemCounters/{counterId} {
      allow read: if signedInAndEnabled() && counterId == 'caseNumber';
      allow write: if false;
    }

    match /caseNumberReservations/{caseNumber} {
      allow read: if signedInAndEnabled();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
