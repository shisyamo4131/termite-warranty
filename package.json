{
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "emulators:start": "firebase emulators:start --project demo-termite-warranty --only auth,firestore,functions",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "postinstall": "nuxt prepare",
    "test": "node --test test/warranty.test.mjs test/search-tokens.test.mjs test/case-rows.test.mjs test/local-runtime.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-termite-warranty --only firestore \"node --test --test-concurrency=1 test/firestore-rules.test.mjs test/emulator/registration.test.mjs\"",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.2",
    "firebase-admin": "14.3.0",
    "firebase-tools": "15.29.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "vuetify": "3.13.3",
    "vuetify-nuxt-module": "0.19.5"
  }
}
